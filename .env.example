# Generate each 32-byte base64 key with: openssl rand -base64 32
RELAY_TOKEN_HASH_KEY=
RELAY_ENCRYPTION_KEY=
# Generate with: printf 'relay_cli_%s\n' "$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
RELAY_CLI_TOKEN=
# Name recorded for the machine bootstrapped from RELAY_CLI_TOKEN. Link others with relayctl host enroll.
RELAY_CLI_HOST_NAME=primary
# Comma-separated HTTPS tap-link hostnames. Empty disables notification links.
RELAY_ALLOWED_URL_HOSTS=

APNS_BUNDLE_ID=com.example.relay
APNS_KEY_ID=
APPLE_TEAM_ID=

# Cloudflare Tunnel token for the public Relay hostname.
CLOUDFLARE_TUNNEL_TOKEN=

# Restricted NAS SFTP repository and credentials used by restic.
RESTIC_REPOSITORY=sftp:relay-backup@nas:/volume/relay-restic
NAS_SSH_KEY_PATH=/absolute/path/to/relay-backup-ed25519
NAS_KNOWN_HOSTS_PATH=/absolute/path/to/known_hosts
BACKUP_INTERVAL_SECONDS=86400
