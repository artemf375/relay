{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "deploy/cloudflare.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [{
    "class_name": "RelayContainer",
    "image": "./Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayContainer"] }],
  "triggers": { "crons": ["* * * * *"] }
}
