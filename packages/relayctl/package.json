{
  "name": "relayctl",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "bin": {
    "relayctl": "bin/relayctl.mjs"
  },
  "exports": "./src/cli.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @relay/contracts build && pnpm build",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage"
  },
  "dependencies": {
    "@relay/contracts": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.8",
    "tsx": "^4.20.6"
  }
}
